intChange(event) {\\n75|      if (!event.matches) {\\n76|        closeNav();\\n77|      }\\n78|    }\\n79|\\n80|    if (typeof mobile.addEventListener === 'function') {\\n81|      mobile.addEventListener('change', onBreakpointChange);\\n82|    } else if (typeof mobile.addListener === 'function') {\\n83|      mobile.addListener(onBreakpointChange);\\n84|    }\\n85|  }\\n86|\\n87|  /* --- 2. Demo contact form ---------------------------------------------- */\\n88|\\n89|  function initContactForm() {\\n90|    var form = document.getElementById('contact-form');\\n91|\\n92|    if (!form) {\\n93|      return;\\n94|    }\\n95|\\n96|    var status = document.getElementById('form-status');\\n97|    var fields = Array.prototype.slice.call(form.querySelectorAll('input, textarea'));\\n98|    var summaryScheduled = false;\\n99|\\n100|    function labelFor(field) {\\n101|      var label = field.id ? form.querySelector('label[for=\\\"' + field.id + '\\\"]') : null;\\n102|\\n103|      if (!label) {\\n104|        return 'This field';\\n105|      }\\n106|\\n107|      return label.textContent.replace(/\\\\s*\\\\(optional\\\\)\\\\s*/i, ' ').replace(/\\\\s+/g, ' ').trim();\\n108|    }\\n109|\\n110|    function firstInvalidField() {\\n111|      for (var i = 0; i < fields.length; i += 1) {\\n112|        if (!fields[i].checkValidity()) {\\n113|          return fields[i];\\n114|        }\\n115|      }\\n116|\\n117|      return null;\\n118|    }\\n119|\\n120|    function setStatus(message, state) {\\n121|      if (!status) {\\n122|        return;\\n123|      }\\n124|\\n125|      status.textContent = message;\\n126|      status.setAttribute('data-state', state);\\n127|    }\\n128|\\n129|    /* Native validation fires one \\\"invalid\\\" event per field; coalescing them\\n130|       into a single summary keeps the message stable instead of flickering\\n131|       through each field in turn. */\\n132|    function scheduleSummary() {\\n133|      if (summaryScheduled) {\\n134|        return;\\n135|      }\\n136|\\n137|      summaryScheduled = true;\\n138|\\n139|      window.setTimeout(function () {\\n140|        summaryScheduled = false;\\n141|\\n142|        var field = firstInvalidField();\\n143|\\n144|        if (!field) {\\n145|          return;\\n146|        }\\n147|\\n148|        setStatus(\\n149|          'Please check \\\"' + labelFor(field) + '\\\": ' + field.validationMessage,\\n150|          'error'\\n151|        );\\n152|      }, 0);\\n153|    }\\n154|\\n155|    fields.forEach(function (field) {\\n156|      field.addEventListener('invalid', function () {\\n157|        field.setAttribute('aria-invalid', 'true');\\n158|        scheduleSummary();\\n159|      });\\n160|\\n161|      /* Clear the error the moment the field becomes valid again. */\\n162|      field.addEventListener('input', function () {\\n163|        if (field.checkValidity()) {\\n164|          field.removeAttribute('aria-invalid');\\n165|        }\\n166|      });\\n167|\\n168|      field.addEventListener('change', function () {\\n169|        if (field.checkValidity()) {\\n170|          field.removeAttribute('aria-invalid');\\n171|        }\\n172|      });\\n173|    });\\n174|\\n175|    form.addEventListener('submit', function (event) {\\n176|      /* Nothing is sent and no navigation happens: this is a demo form. */\\n177|      event.preventDefault();\\n178|\\n179|      var invalid = firstInvalidField();\\n180|\\n181|      if (invalid) {\\n182|        invalid.setAttribute('aria-invalid', 'true');\\n183|        invalid.focus();\\n184|        setStatus('Please check \\\"' + labelFor(invalid) + '\\\": ' + invalid.validationMessage, 'error');\\n185|        return;\\n186|      }\\n187|\\n188|      var nameField = document.getElementById('name');\\n189|      var name = nameField ? nameField.value.trim() : '';\\n190|\\n191|      /* Order matters: clear the fields, then announce. Announcing first and\\n192|         resetting afterwards wiped the success message before anyone saw it. */\\n193|